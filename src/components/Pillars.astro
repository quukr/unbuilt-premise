---
const inquiryThemes = [
    {
        index: "01",
        title: "Assumptions Under Stress",
        summary: "Examining core hypotheses that looked infallible until direct encounter with engineering constraints, physics, or human reality broke them."
    },
    {
        index: "02",
        title: "Hidden Systems & Friction",
        summary: "The silent scaffolding behind healthcare delivery, technical infrastructure, and institutions that remains invisible until breakdown occurs."
    },
    {
        index: "03",
        title: "Failure & Course Corrections",
        summary: "What operators, researchers, and thinkers understand now that they did not before their original roadmap collapsed."
    }
];
---
<section id="focus" class="border-t border-charcoal-border py-20">
    <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-2xl mb-12 space-y-2">
            <p class="text-xs font-mono tracking-widest text-lime uppercase">Dialogue Structure</p>
            <h2 class="text-3xl font-bold text-offwhite tracking-tight">Lines of Inquiry</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {inquiryThemes.map((item) => (
                    <div class="p-8 bg-charcoal-light border border-charcoal-border rounded hover:border-offwhite-muted/40 transition-colors">
                        <span class="text-xs font-mono text-lime block mb-4">{item.index}</span>
                        <h3 class="text-xl font-bold text-offwhite mb-3">{item.title}</h3>
                        <p class="text-sm text-offwhite-muted leading-relaxed font-serif">{item.summary}</p>
                    </div>
            ))}
        </div>
    </div>
</section>