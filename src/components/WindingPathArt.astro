---
---
<div class="relative w-full aspect-square max-w-[420px] mx-auto bg-charcoal-light border border-charcoal-border rounded-xl p-8 flex flex-col justify-between overflow-hidden shadow-2xl">
    <!-- Subtle Background Grid -->
    <div class="absolute inset-0 bg-[radial-gradient(#2a2a2a_1px,transparent_1px)] [background-size:16px_16px] opacity-40"></div>

    <!-- Cover Top Label -->
    <div class="relative z-10 flex justify-between items-center text-xs tracking-widest text-offwhite-muted uppercase">
        <span>Audio / Dialogue</span>
        <span class="text-lime font-mono">Vol. 01</span>
    </div>

    <!-- The Winding Path Hero Graphic -->
    <div class="relative z-10 my-auto py-8">
        <svg viewBox="0 0 200 200" fill="none" class="w-full h-auto drop-shadow-sm">
            <!-- Faint guide track -->
            <path
                    d="M20 180 C20 120, 90 130, 90 80 C90 30, 180 40, 180 20"
                    stroke="#2a2a2a"
                    stroke-width="12"
                    stroke-linecap="round"
            />
            <!-- Unfinished Winding Path in Electric Lime -->
            <path
                    d="M20 180 C20 120, 90 130, 90 80 C90 30, 180 40, 180 20"
                    stroke="#C8F23D"
                    stroke-width="5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
            />
            <!-- Terminating unresolved node -->
            <circle cx="180" cy="20" r="4.5" fill="#C8F23D" />
            <circle cx="20" cy="180" r="3.5" fill="#F4F1E8" />
        </svg>
    </div>

    <!-- Cover Bottom Title -->
    <div class="relative z-10 border-t border-charcoal-border pt-4">
        <div class="text-2xl font-bold tracking-tight text-offwhite">UNBUILT PREMISE</div>
        <div class="text-xs text-offwhite-muted font-serif italic mt-0.5">Ideas are rarely as simple as they look.</div>
    </div>
</div>