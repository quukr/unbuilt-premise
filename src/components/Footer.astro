---
<footer class="border-t border-charcoal-border py-12 bg-charcoal">
    <div class="max-w-6xl mx-auto px-6 space-y-8">

        <div class="flex flex-col md:flex-row items-center justify-between gap-6">

            <!-- Brand & Host -->
            <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
                <span class="font-bold text-offwhite uppercase tracking-wider text-sm">Unbuilt Premise</span>
                <span class="hidden sm:inline text-charcoal-border">|</span>
                <span class="text-xs text-offwhite-muted">Hosted by Emmanuel</span>
            </div>

            <!-- Social SVG Icons Grid -->
            <div class="flex items-center flex-wrap justify-center gap-4 text-offwhite-muted">
                {socials.map((s) => (
                        <a
                                href={s.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={s.name}
                                class="p-2 rounded-full hover:text-lime hover:bg-charcoal-light transition-colors"
                        >
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" set:html={s.svg} />
                        </a>
                ))}
            </div>

        </div>

        <!-- Copyright Subline -->
        <div class="pt-6 border-t border-charcoal-border/50 flex flex-col sm:flex-row items-center justify-between text-[11px] text-offwhite-muted gap-2 text-center sm:text-left">
            <span>Ideas are rarely as simple as they look.</span>
            <span>&copy; {currentYear} Unbuilt Premise. All rights reserved.</span>
        </div>

    </div>
</footer>