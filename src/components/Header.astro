---
import { Image } from 'astro:assets';
import upLogo from '../assets/up_logo.jpg';
---

<header class="border-b border-charcoal-border sticky top-0 bg-charcoal/95 backdrop-blur-md z-50">
    <div class="max-w-6xl mx-auto px-6 py-3.5 flex items-center justify-between">
        <!-- Brand & Logo -->
        <a href="/" class="flex items-center gap-3 group">
            <div class="relative w-8 h-8 sm:w-9 sm:h-9 shrink-0 overflow-hidden rounded-md border border-charcoal-border group-hover:border-lime transition-colors duration-200">
                <Image
                        src={upLogo}
                        alt="Unbuilt Premise Logo"
                        width={72}
                        height={72}
                        class="w-full h-full object-cover"
                        loading="eager"
                        fetchpriority="high"
                />
            </div>
            <span class="text-base sm:text-lg font-bold tracking-tight text-offwhite uppercase group-hover:text-lime transition-colors duration-200">
                Unbuilt Premise
            </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
            <a href="#about" class="text-offwhite-muted hover:text-offwhite transition-colors">About the Show</a>
            <a href="#focus" class="text-offwhite-muted hover:text-offwhite transition-colors">Areas of Inquiry</a>
            <a href="#listen" class="text-offwhite-muted hover:text-offwhite transition-colors">Listen</a>
            <a
                    href="#dispatch"
                    class="bg-lime text-charcoal px-4 py-2 rounded-sm font-semibold hover:bg-lime-hover transition-colors"
            >
                Subscribe
            </a>
        </nav>

        <!-- Mobile Hamburger Button -->
        <button
                id="menu-toggle"
                type="button"
                class="md:hidden p-2 text-offwhite hover:text-lime focus:outline-none focus:ring-1 focus:ring-lime rounded"
                aria-label="Toggle Navigation Menu"
                aria-expanded="false"
        >
            <!-- Hamburger Bars Icon -->
            <svg id="icon-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <!-- Close (X) Icon -->
            <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-charcoal-border bg-charcoal-light px-6 py-6 space-y-4">
        <a href="#about" class="mobile-nav-link block text-base font-medium text-offwhite-muted hover:text-offwhite">About the Show</a>
        <a href="#focus" class="mobile-nav-link block text-base font-medium text-offwhite-muted hover:text-offwhite">Areas of Inquiry</a>
        <a href="#listen" class="mobile-nav-link block text-base font-medium text-offwhite-muted hover:text-offwhite">Where to Listen</a>
        <a
                href="#dispatch"
                class="mobile-nav-link block text-center bg-lime text-charcoal py-2.5 rounded-sm font-semibold hover:bg-lime-hover transition-colors"
        >
            Subscribe for Dispatches
        </a>
    </div>
</header>

<script>
    const toggleBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (toggleBtn && mobileMenu && iconOpen && iconClose) {
        toggleBtn.addEventListener('click', () => {
            const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
            toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
            mobileMenu.classList.toggle('hidden');
            iconOpen.classList.toggle('hidden');
            iconClose.classList.toggle('hidden');
        });

        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                iconOpen.classList.remove('hidden');
                iconClose.classList.add('hidden');
                toggleBtn.setAttribute('aria-expanded', 'false');
            });
        });
    }
</script>