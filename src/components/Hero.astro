---
import WindingPathArt from "./WindingPathArt.astro";
---
<section class="max-w-6xl mx-auto px-6 pt-12 pb-16 md:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

        <div class="lg:col-span-7 flex flex-col items-start space-y-6">

            <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-offwhite leading-[1.08]">
                Ideas are rarely as simple as they look.
            </h1>

            <p class="text-lg sm:text-xl text-offwhite-muted leading-relaxed font-serif">
                Unbuilt Premise is a series of conversations about the ideas, decisions and assumptions behind the things people build, question and pursue.
            </p>

            <!-- Primary Podcast Actions -->
            <div class="pt-2 w-full sm:w-auto flex flex-col sm:flex-row gap-3">
                <a
                        href="https://open.spotify.com/show/3nQ4vXMH1WkOmDwAabuzPF"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded bg-lime text-charcoal font-semibold text-sm hover:bg-lime-hover transition-colors"
                >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.494 17.306c-.215.353-.674.464-1.027.249-2.812-1.718-6.353-2.107-10.523-1.155-.403.092-.807-.16-.899-.562-.092-.402.16-.807.562-.899 4.568-1.044 8.487-.6 11.638 1.34.353.215.464.674.249 1.027zm1.465-3.26c-.27.44-.847.579-1.287.31-3.219-1.978-8.125-2.55-11.932-1.393-.497.15-1.025-.133-1.175-.63-.151-.496.133-1.025.63-1.175 4.354-1.321 9.774-.682 13.454 1.581.44.27.579.847.31 1.287zm.126-3.41c-3.86-2.292-10.228-2.504-13.914-1.385-.593.18-1.222-.154-1.402-.747-.18-.593.154-1.222.747-1.402 4.237-1.286 11.272-1.037 15.704 1.593.533.316.708 1.008.392 1.541-.316.533-1.008.708-1.527.4z"/>
                    </svg>
                    Listen on Spotify
                </a>

                <a
                        href="https://www.youtube.com/@UnbuiltPremise"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded border border-charcoal-border bg-charcoal-light text-offwhite font-medium text-sm hover:border-offwhite-muted transition-colors"
                >
                    <svg class="w-4 h-4 fill-current text-red-500" viewBox="0 0 24 24">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                    Watch on YouTube
                </a>
            </div>

            <div class="pt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-offwhite-muted font-mono">
                <span>Technology</span>
                <span>/</span>
                <span>Healthcare</span>
                <span>/</span>
                <span>Science</span>
                <span>/</span>
                <span>Engineering</span>
                <span>/</span>
                <span>Africa</span>
            </div>
        </div>

        <!-- Show Art Visual -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
            <WindingPathArt />
        </div>

    </div>
</section>